{
  "manifest_version": 3,
  "name": "PokeRogue Cerveau",
  "version": "0.10.0",
  "description": "Affiche ce que le cerveau voit et pense de ta partie PokeRogue, et peut jouer à ta place.",
  "content_scripts": [
    {
      "matches": [
        "https://pokerogue.net/*",
        "http://localhost:8000/*"
      ],
      "js": [
        "capteur.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://pokerogue.net/*",
        "http://localhost:8000/*"
      ],
      "js": [
        "panneau.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "unlimitedStorage"
  ]
}
